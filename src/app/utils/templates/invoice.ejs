<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Booking Invoice</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f7f7f7;
        color: #333;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background: #fff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      }
      .btn {
        display: inline-block;
        padding: 12px 24px;
        background: #28a745;
        color: #fff;
        text-decoration: none;
        border-radius: 4px;
        margin-top: 20px;
      }
      .footer {
        margin-top: 30px;
        font-size: 12px;
        color: #888;
        text-align: center;
      }
      .details {
        margin-top: 20px;
      }
      .details p {
        margin: 6px 0;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>Booking Invoice</h2>
      <p>Hello <%= cusName %>,</p>

      <p>Thank you for booking with PH Tour Management! Here are your booking details:</p>

      <div class="details">
        <p><strong>Payment ID:</strong> <%= transactionId %></p>
        <p><strong>Booking Date:</strong> <%= bookingDate %></p>
        <p><strong>Tour Package:</strong> <%= tourTitle %></p>
        <p><strong>Guests:</strong> <%= guestCount %></p>
        <p><strong>Amount Paid:</strong> $<%= totalAmount.toFixed(2) %></p>
      </div>

      <h3>Customer Information</h3>
      <div class="details">
        <p><strong>Name:</strong> <%= cusName %></p>
        <p><strong>Email:</strong> <%= cusEmail %></p>
        <p><strong>Phone:</strong> <%= cusPhone %></p>
        <p><strong>Address:</strong> <%= cusAddress %></p>
      </div>

      <p>You can download your invoice PDF below:</p>
      <a class="btn" href="#">Download Invoice PDF</a>

      <p>If you have any questions, feel free to contact our support team.</p>

      <div class="footer">&copy; Velotix. All rights reserved.</div>
    </div>
  </body>
</html>